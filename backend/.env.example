# =====================================================================
# CarbonShift - backend settings
# Copy this file to .env and fill in your keys. Never commit .env.
# Only GROQ_API_KEY is required; every other service is optional and
# the app falls back to its built-in data when a key is empty.
# =====================================================================


# ---------------------------------------------------------------------
# AI model (REQUIRED)
# Groq: https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Three comma-separated backup models are configured by default. Override with
# model IDs currently available to your Groq account (see https://console.groq.com/docs/models).
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b


# ---------------------------------------------------------------------
# Accounts and cloud history (Supabase PostgreSQL)
# Keep the service-role key on the backend only; never put it in frontend/.env.local.
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key


# ---------------------------------------------------------------------
# Default region
# Country used when a description doesn't say where (ISO code, e.g. IN).
# Leave empty to use the world-average electricity grid.
# ---------------------------------------------------------------------
# DEFAULT_REGION=IN


# ---------------------------------------------------------------------
# Road distances and driving times: OpenRouteService
# Free key: https://openrouteservice.org/dev/#/signup
# Free plan: 2,000 directions/day, 500 distance matrices/day.
# Attribution required in the app: "(c) openrouteservice.org, (c) OpenStreetMap contributors"
# ---------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=


# ---------------------------------------------------------------------
# Flight emissions: Google Travel Impact Model (same model as Google Flights)
# 1. https://console.cloud.google.com -> create a project
# 2. APIs & Services -> Library -> enable "Travel Impact Model API"
# 3. APIs & Services -> Credentials -> Create credentials -> API key
#    (restrict the key to the Travel Impact Model API)
# Free of charge.
# ---------------------------------------------------------------------
GOOGLE_TRAVEL_IMPACT_API_KEY=


# ---------------------------------------------------------------------
# Electricity grid carbon intensity by country (monthly): Ember
# Free key: https://ember-energy.org/data/api/
# Data licence CC BY 4.0 - credit "Ember" where the figures are shown.
# ---------------------------------------------------------------------
EMBER_API_KEY=


# ---------------------------------------------------------------------
# Live grid carbon intensity (optional): Electricity Maps
# Free tier: https://portal.electricitymaps.com - ONE zone only, non-commercial use.
# Zone for your area, e.g. IN-NO (northern India); check the zone list in their portal.
# ---------------------------------------------------------------------
ELECTRICITYMAPS_API_KEY=
ELECTRICITYMAPS_ZONE=


# ---------------------------------------------------------------------
# No key needed (listed so you know they're used)
#   Open-Meteo      weather forecasts      free for non-commercial use, <10,000 calls/day
#   OurAirports     airport coordinates    public-domain CSV
#   Open Food Facts food product footprints open data
# Some free services ask for a contact address in requests; set yours here.
# ---------------------------------------------------------------------
# CONTACT_EMAIL=
